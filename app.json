{
  "expo": {
    "name": "LifeStack",
    "slug": "lifestack-app",
    "scheme": "lifestack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifestack.app"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
